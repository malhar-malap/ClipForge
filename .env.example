# ClipForge settings. Copy this file to `.env` and fill in what you need. Never commit `.env`.
# On your own computer nothing here is required: start ClipForge and set the AI key in Settings → AI.
# Lines starting with # are optional; remove the # to use one.

# ─── AI (picks the moments, frames gameplay, writes hooks and titles) ─────────────────────────────────────────────
PEAKCUT_AI_PROVIDER=anthropic          # anthropic | gemini | openai | openrouter | groq | xai | ollama | custom
PEAKCUT_AI_MODELS=claude-haiku-5-5     # comma separated, tried in order; a vision-capable model also frames clips
PEAKCUT_AI_KEY=
# PEAKCUT_AI_KEY_FILE=/secrets/ai.txt  # instead of PEAKCUT_AI_KEY
# CLIPFORGE_RANK_MODELS=claude-sonnet-5-5   # stronger second pass that ranks the best moments (paid plans)
# CLIPFORGE_WHISPER_MODEL=small        # speech-to-text for non-English videos: small | medium | large-v3

# ─── Where things live ────────────────────────────────────────────────────────────────────────────────────────────
# PEAKCUT_DATA=./data                  # videos, clips, database and models
# PEAKCUT_PORT=8765
# PEAKCUT_PUBLIC_URL=http://127.0.0.1:8765   # the address people open; https://your-domain on a server
# DATABASE_URL=                        # empty = SQLite in the data folder; or postgresql+psycopg://user:pass@host/db

# ─── Accounts and sign-in (turn on for any server other people can reach) ─────────────────────────────────────────
# PEAKCUT_ACCOUNTS=1
# GOOGLE_CLIENT_FILE=/secrets/google_client.json   # "Sign in with Google": the OAuth client JSON from Google Cloud
# GOOGLE_CLIENT_ID=                    # ...or the id and secret directly
# GOOGLE_CLIENT_SECRET=
# PEAKCUT_VERIFY_EMAIL=1               # people confirm their email before clipping
# Make yourself an admin after signing up:  python -m studio.admin grant you@example.com

# ─── Email (welcome, confirm email, password reset, password changed, receipts, clips ready) ──────────────────────
# With Gmail: turn on 2-Step Verification, make an App Password at https://myaccount.google.com/apppasswords
# and paste it into the password file (spaces are fine). Gmail sends about 500 emails a day; use your own domain
# with a sending service (Resend, Postmark, Amazon SES, Zoho) once you launch.
# PEAKCUT_SMTP_HOST=smtp.gmail.com
# PEAKCUT_SMTP_PORT=587                # 465 also works (SSL from the start)
# PEAKCUT_SMTP_USER=you@gmail.com
# PEAKCUT_SMTP_PASSWORD=               # or PEAKCUT_SMTP_PASSWORD_FILE=/secrets/smtp.txt
# PEAKCUT_MAIL_FROM=ClipForge <you@gmail.com>   # with Gmail this must be the same address as the user
# Admins can preview every email at /api/admin/email-preview?kind=welcome and send themselves a test from the admin page.

# ─── Plans and payments (the hosted ClipForge site) ───────────────────────────────────────────────────────────────
# CLIPFORGE_BILLING=1
# CLIPFORGE_SECRET_KEY=                # encrypts users' own AI keys; make one with:
#                                      # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=                 # or RAZORPAY_KEY_SECRET_FILE
# RAZORPAY_WEBHOOK_SECRET=             # webhook URL: https://your-domain/api/billing/webhook
# CLIPFORGE_PREVIEWS_PER_DAY=2
# CLIPFORGE_PREVIEW_MAX_MINUTES=60
# CLIPFORGE_PREVIEW_CLIPS=3

# ─── Posting to YouTube, Instagram and TikTok (optional) ──────────────────────────────────────────────────────────
# PEAKCUT_IG_APP_ID=
# PEAKCUT_IG_APP_SECRET=
# PEAKCUT_TIKTOK_CLIENT_KEY=
# PEAKCUT_TIKTOK_CLIENT_SECRET=        # YouTube posting uses the Google client above

# ─── Server with Docker (see docs/DEPLOY.md) ──────────────────────────────────────────────────────────────────────
# PEAKCUT_DOMAIN=clipforge.example.com
# POSTGRES_PASSWORD=change-me-to-a-long-random-string
# COMPOSE_PROFILES=own-https           # a server of its own: Caddy gets the HTTPS certificate
# PEAKCUT_CLIENT_IP_HEADER=CF-Connecting-IP   # behind Cloudflare
# PEAKCUT_CONTACT_EMAIL=               # shown on the privacy and terms pages
# PEAKCUT_LEGAL_NAME=
# PEAKCUT_LEGAL_COUNTRY=

# ─── Limits (all optional; 0 = no limit) ──────────────────────────────────────────────────────────────────────────
# PEAKCUT_MAX_UPLOAD_MB=0
# PEAKCUT_MAX_VIDEO_HOURS=0
# PEAKCUT_MAX_JOBS_PER_USER=5
# PEAKCUT_MAX_USER_GB=0
# PEAKCUT_MAX_LIVE_PER_USER=0
# PEAKCUT_JOB_WORKERS=8
# PEAKCUT_ALLOWED_SITES=youtube.com,youtu.be,twitch.tv,kick.com

# Every other setting, with its default, is in studio/config.py.
